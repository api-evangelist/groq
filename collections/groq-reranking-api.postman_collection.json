                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"<string>\",\n  \"query\": \"<string>\",\n  \"docs\": [\n    \"<string>\"\n  ],\n  \"instruction\": \"<string>\"\n}",
